{
  "name": "personal-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "auth:key": "node scripts/generate-auth-key.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "test:task-scroll-browser": "node scripts/task-scroll-browser-check.mjs",
    "test:auth-browser": "node scripts/auth-browser-check.mjs",
    "format": "prettier --write src server scripts *.json *.ts *.js index.html README.md",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test:cloud-browser": "node scripts/cloud-browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
